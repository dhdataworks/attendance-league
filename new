// ===================== PRINTING =====================
function printWith(bodyClass, size, margin) {
  let ps = document.getElementById('printPageStyle');
  if (!ps) { ps = document.createElement('style'); ps.id = 'printPageStyle'; document.head.appendChild(ps); }
  ps.textContent = `@media print { @page { size: ${size}; margin: ${margin}; } }`;
  if (bodyClass) document.body.classList.add(bodyClass);
  window.print();
  setTimeout(() => { if (bodyClass) document.body.classList.remove(bodyClass); }, 500);
}
function printPage() { printWith(null, 'A3 portrait', '10mm'); }   // prints the view on screen
function printSheet() { printWith('printing-sheet', 'A4 portrait', '10mm'); }

// ===================== HIGHLIGHTS =====================
function buildHighlights() {
  const sorted = getSortedClasses().filter(c => getStats(c).played > 0);
  const lw = latestWeekWithData();
  const top3 = sorted.slice(0, 3).map((c, i) => {
    const s = getStats(c);
    return `<div class="card hl-row" style="padding:14px 18px;margin-bottom:10px;border-left:5px solid ${c.colour}">
      ${rankBadge(i + 1, true)}
      <div style="flex:1;min-width:0"><div style="font-weight:700;font-size:1.05rem">${nm(c)}</div><div style="color:var(--dim);font-size:0.82rem">${c.house ? esc(c.house) + ' · ' : ''}${pct(s.overallPct)} average · ${plural(s.wins, 'win')}</div></div>
      <div style="font-weight:700;font-size:1.3rem">${s.pts}<span style="font-size:0.8rem;color:var(--dim);font-weight:500"> pts</span></div>
    </div>`;
  }).join('') || '<div class="empty">No results recorded yet.</div>';

  const houses = getHouseStats();
  const houseHtml = usingHouses && houses.length ? `
    <div class="hl-section">Winning house</div>
    <div class="card hl-row" style="padding:14px 18px;border-left:5px solid ${houses[0].colour}">
      <div style="flex:1"><div style="font-weight:700;font-size:1.05rem">${esc(houses[0].name)}</div><div style="color:var(--dim);font-size:0.82rem">${pct(houses[0].avg)} average · ${plural(houses[0].wins, 'weekly win')}</div></div>
      <div style="font-weight:700;font-size:1.3rem">${houses[0].pts}<span style="font-size:0.8rem;color:var(--dim);font-weight:500"> pts</span></div>
    </div>` : '';

  const mi = getMostImprovedAllTime(), bc = getBiggestClimberAllTime();
  const mention = (title, body) => `<div class="card" style="padding:14px 16px"><div style="font-size:0.78rem;color:var(--dim)">${title}</div><div style="font-weight:600;margin-top:2px">${body}</div></div>`;
  const mentions = `<div class="grid" style="grid-template-columns:1fr 1fr">
    ${mention('📈 Biggest weekly rise', mi ? `${nm(mi.cls)} <span style="color:var(--win)">+${mi.diff.toFixed(1)}%</span> <span style="color:var(--dim);font-weight:400">(Week ${mi.fromWeek} → ${mi.toWeek})</span>` : 'Not enough weeks yet')}
    ${mention('🚀 Biggest climber', bc ? `${nm(bc.cls)} <span style="color:var(--win)">▲${bc.places}</span> <span style="color:var(--dim);font-weight:400">(Week ${bc.fromWeek} → ${bc.toWeek})</span>` : 'Not enough weeks yet')}
  </div>`;

  const badgeCards = BADGES.map(b => {
    const winners = getSortedClasses().filter(c => b.check(entriesUpTo(c)));
    if (!winners.length) return '';
    return `<div class="card" style="padding:12px 14px"><div style="font-weight:600">${b.emoji} ${b.name}</div><div style="font-size:0.78rem;color:var(--dim);margin-bottom:8px">${b.desc}</div>
      <div style="display:flex;flex-wrap:wrap;gap:5px">${winners.map(c => `<span class="gchip"><span class="dot" style="background:${c.colour}"></span>${nm(c)}</span>`).join('')}</div></div>`;
  }).filter(Boolean).join('');

  return `<div class="sheet-head"><h2>Highlights</h2><p>${esc(settings.title || 'Attendance League')}${lw ? ' · after Week ' + lw : ''}</p></div>
    <div class="hl-section">Top three</div>${top3}
    ${houseHtml}
    <div class="hl-section">Special mentions</div>${mentions}
    <div class="hl-section">Badge winners</div>
    ${badgeCards ? `<div class="hl-badges">${badgeCards}</div>` : '<div class="empty">No badges earned yet.</div>'}`;
}
function openHighlights() {
  if (!classes.length) { toast('No data loaded yet'); return; }
  document.getElementById('highlightsSheet').innerHTML = buildHighlights();
  document.getElementById('highlightsOverlay').classList.add('open');
}
function closeHighlights() { document.getElementById('highlightsOverlay').classList.remove('open'); }

// ===================== TUTOR CARDS =====================
function openTutorCards() {
  if (!classes.length) { toast('No data loaded yet'); return; }
  const sorted = getSortedClasses(), prev = getMovements();
  document.getElementById('cardsGrid').innerHTML = sorted.map((c, i) => groupCardHTML(c, i + 1, sorted.length, prev[c.id], false)).join('');
