// ===================== LEAGUE NEWS =====================
function buildNewsLines() {
  const lines = [];
  const sorted = getSortedClasses().filter(c => getStats(c).played > 0);
  if (!sorted.length) return lines;
  const latest = latestWeekWithData();

  const leader = sorted[0];
  lines.push(`👑 ${nm(leader)} lead the league on ${getStats(leader).pts} points`);

  const race = getTitleRace();
  if (race && race.gap <= 3) {
    lines.push(race.gap === 0
      ? `⚔ ${nm(race.chaser)} are level on points with ${nm(race.leader)} at the top`
      : `⚔ Just ${plural(race.gap, 'point')} between ${nm(race.leader)} and ${nm(race.chaser)} at the top`);
  }

  let sBest = null, sVal = 0;
  classes.forEach(c => { const st = getStats(c).streak; if (st > sVal) { sVal = st; sBest = c; } });
  if (sBest && sVal >= 2) lines.push(`🔥 ${nm(sBest)} have won ${sVal} weeks in a row at 95%+`);

  const unbeaten = classes.filter(isUnbeaten);
  if (unbeaten.length === 1) lines.push(`🛡 ${nm(unbeaten[0])} are the only group never to drop below 90%`);
  else if (unbeaten.length > 1 && unbeaten.length <= 4) lines.push(`🛡 Still unbeaten (never below 90%): ${unbeaten.map(nm).join(', ')}`);

  const bc = getBiggestClimber();
  if (bc && bc.places >= 2) lines.push(`🚀 ${nm(bc.cls)} climbed ${bc.places} places this week`);
  const mi = getMostImproved();
  if (mi && mi.diff >= 1) lines.push(`📈 Biggest riser: ${nm(mi.cls)}, up ${mi.diff.toFixed(1)}% on the week before`);

  if (latest) {
    const perfect = classes.filter(c => c.attendance[latest] === 100);
    if (perfect.length && perfect.length <= 5) lines.push(`💯 100% attendance in Week ${latest}: ${perfect.map(nm).join(', ')}`);
    const wins = classes.filter(c => c.attendance[latest] !== undefined && c.attendance[latest] >= 95).length;
    if (wins) lines.push(`✅ ${plural(wins, 'group')} won Week ${latest} with 95%+`);
  }

  if (usingHouses) {
    const hs = getHouseStats();
    if (hs.length >= 2) {
      const gap = hs[0].pts - hs[1].pts;
      lines.push(gap <= 5
        ? `🏠 Close house race: ${esc(hs[0].name)} lead ${esc(hs[1].name)} by ${plural(gap, 'point')}`
        : `🏠 ${esc(hs[0].name)} lead the house race on ${hs[0].pts} points`);
    }
  }

  lines.push(`🎯 Every week at 95%+ is a win worth 3 points, wherever a group sits in the table`);
  return lines;
}
function renderNews() {
  const lines = buildNewsLines();
  const lw = latestWeekWithData();
  const sub = `${plural(lines.length, 'headline')}${lw ? ' · after Week ' + lw : ''}`;
  document.getElementById('newsHint').textContent = sub;
  document.getElementById('newsListSub').textContent = sub;
  const item = (l, i) => `<div class="news-item"><span class="news-n">${String(i + 1).padStart(2, '0')}</span><span class="news-t">${l}</span></div>`;
  document.getElementById('newsPreview').innerHTML = lines.slice(0, 4).map(item).join('') || '<div class="empty">Headlines appear once weekly attendance is entered.</div>';
  document.getElementById('newsList').innerHTML = lines.map(item).join('') || '<div class="empty">Headlines appear once weekly attendance is entered.</div>';
}

