<!DOCTYPE html>
<html lang="en-GB">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Attendance League</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<style>
  /* ============================================================
     ATTENDANCE LEAGUE — CLEAN EDITION
     Light card layout with a left navigation rail, matching the
     behaviour dashboard. Weekly points: 3 / 2 / 1 / 0.
     ============================================================ */
  :root {
    --bg:        #f4f6fb;
    --card:      #ffffff;
    --line:      #e6e9f0;
    --line-soft: #f0f2f7;
    --ink:       #1f2937;
    --ink-2:     #4b5563;
    --dim:       #8a93a6;
    --accent:    #5b5bd6;
    --accent-bg: #eef0ff;

    /* result bands */
    --win:     #15803d;  --win-bg:   #e7f6ec;
    --draw:    #a16207;  --draw-bg:  #fdf3dc;
    --point:   #2563c9;  --point-bg: #e7effc;
    --none:    #c2415a;  --none-bg:  #fcebee;

    /* podium */
    --gold:   #c99a1e;  --gold-bg:   #fdf5dd;
    --silver: #7a8597;  --silver-bg: #eef1f5;
    --bronze: #b06a3b;  --bronze-bg: #f9ece3;

    --radius: 14px;
    --shadow: 0 1px 2px rgba(16,24,40,.04), 0 4px 16px rgba(16,24,40,.05);
    --shadow-lg: 0 12px 40px rgba(16,24,40,.16);
  }
  * { margin: 0; padding: 0; box-sizing: border-box; }
  html, body { background: var(--bg); }
  body {
    color: var(--ink); font-family: 'Inter', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 14px; line-height: 1.5; -webkit-font-smoothing: antialiased;
  }
  button { font-family: inherit; }
  [hidden] { display: none !important; }

  .ico { width: 18px; height: 18px; flex-shrink: 0; }

  /* ===================== APP SHELL ===================== */
  .app { display: grid; grid-template-columns: 236px 1fr; min-height: 100vh; }

  .rail {
    position: sticky; top: 0; height: 100vh; overflow-y: auto;
    background: var(--card); border-right: 1px solid var(--line);
    display: flex; flex-direction: column; padding: 20px 14px;
  }
  .brand { display: flex; align-items: center; gap: 11px; padding: 0 8px 20px; }
  .brand-mark {
    width: 38px; height: 38px; border-radius: 11px; flex-shrink: 0;
    background: var(--accent-bg); color: var(--accent);
    display: flex; align-items: center; justify-content: center;
  }
  .brand-mark .ico { width: 21px; height: 21px; }
  .brand-title { font-weight: 700; font-size: 0.98rem; line-height: 1.2; }
  .brand-sub { font-size: 0.76rem; color: var(--dim); }

  .nav-label {
    font-size: 0.68rem; font-weight: 600; letter-spacing: 0.08em; text-transform: uppercase;
    color: var(--dim); padding: 14px 10px 6px;
  }
  .nav-item {
    display: flex; align-items: center; gap: 11px; width: 100%;
    background: none; border: none; border-radius: 10px; cursor: pointer;
    padding: 9px 10px; font-size: 0.88rem; font-weight: 500; color: var(--ink-2);
    text-align: left; transition: background .15s, color .15s;
  }
  .nav-item:hover { background: var(--line-soft); color: var(--ink); }
  .nav-item.active { background: var(--accent-bg); color: var(--accent); font-weight: 600; }
  .rail-foot { margin-top: auto; padding-top: 14px; border-top: 1px solid var(--line-soft); position: relative; }
  .credit-btn {
    position: absolute; right: 6px; bottom: 9px; width: 22px; height: 22px; border-radius: 50%;
    border: 1px solid var(--line); background: var(--card); color: var(--dim);
    font-size: 0.72rem; font-weight: 600; cursor: pointer;
  }
  .credit-popup {
    position: absolute; left: 6px; right: 6px; bottom: 44px; display: none;
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    box-shadow: var(--shadow); padding: 8px 10px; font-size: 0.76rem; color: var(--ink-2);
  }
  .credit-popup.open { display: block; }

  .main { min-width: 0; padding: 26px 32px 60px; }

  /* ===================== TOP BAR ===================== */
  .topbar { display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 20px; flex-wrap: wrap; }
  .topbar h1 { font-size: 1.5rem; font-weight: 700; letter-spacing: -0.01em; line-height: 1.2; }
  .status-line { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 8px; }
  .pill {
    display: inline-flex; align-items: center; gap: 5px;
    background: var(--card); border: 1px solid var(--line); border-radius: 999px;
    padding: 3px 10px; font-size: 0.76rem; color: var(--ink-2);
  }
  .top-actions { display: flex; gap: 8px; flex-wrap: wrap; }

  .btn {
    display: inline-flex; align-items: center; gap: 7px;
    background: var(--card); border: 1px solid var(--line); border-radius: 10px;
    padding: 8px 14px; font-size: 0.85rem; font-weight: 500; color: var(--ink);
    cursor: pointer; transition: border-color .15s, background .15s; white-space: nowrap;
  }
  .btn:hover { border-color: #cfd5e1; background: #fafbfd; }
  .btn .ico { width: 16px; height: 16px; color: var(--ink-2); }
  .btn-primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  .btn-primary:hover { background: #4b4bc4; border-color: #4b4bc4; }
  .btn-primary .ico { color: #fff; }
  .btn-sm { padding: 5px 10px; font-size: 0.78rem; border-radius: 8px; }

  /* ===================== ADMIN BAR ===================== */
  .admin-bar {
    display: flex; align-items: center; gap: 8px; flex-wrap: wrap;
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 10px 12px; margin-bottom: 20px;
  }
  .admin-tag {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--accent); background: var(--accent-bg); border-radius: 6px; padding: 3px 8px; margin-right: 4px;
  }
  .entry-tracker { margin-left: auto; display: flex; align-items: center; gap: 10px; font-size: 0.8rem; color: var(--ink-2); }
  .entry-bar { width: 110px; height: 6px; background: var(--line-soft); border-radius: 999px; overflow: hidden; }
  .entry-bar-fill { height: 100%; background: var(--accent); width: 0; border-radius: 999px; transition: width .4s; }

  /* ===================== CARDS & LAYOUT ===================== */
  .card {
    background: var(--card); border: 1px solid var(--line); border-radius: var(--radius);
    box-shadow: var(--shadow); padding: 20px;
  }
  .card + .card, .grid + .card, .card + .grid, .grid + .grid { margin-top: 16px; }
  .grid > .card, .house-grid > .card { margin-top: 0; }
  .card-head { display: flex; align-items: center; justify-content: space-between; gap: 10px; margin-bottom: 14px; }
  .card-title { font-size: 0.98rem; font-weight: 600; }
  .card-hint { font-size: 0.8rem; color: var(--dim); margin-top: 2px; }
  .grid { display: grid; gap: 16px; }
  .grid-kpi { grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .grid-2 { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }

  .view { animation: viewIn .22s ease-out; }
  @keyframes viewIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: none; } }

  /* KPI tiles */
  .kpi { padding: 16px 18px; }
  .kpi-label { font-size: 0.78rem; color: var(--dim); font-weight: 500; }
  .kpi-value { font-size: 1.65rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 4px; line-height: 1.15; }
  .kpi-value small { font-size: 0.9rem; font-weight: 500; color: var(--dim); margin-left: 3px; }
  .kpi-sub { font-size: 0.78rem; color: var(--ink-2); margin-top: 4px; }
  .up { color: var(--win); } .down { color: var(--none); } .flat { color: var(--dim); }

  /* ===================== SMALL PARTS ===================== */
  .dot { width: 10px; height: 10px; border-radius: 50%; flex-shrink: 0; display: inline-block; box-shadow: 0 0 0 2px #fff, 0 0 0 3px rgba(0,0,0,.06); }
  .form-dots { display: inline-flex; gap: 3px; }
  .fd { width: 8px; height: 8px; border-radius: 50%; }
  .fd.win { background: var(--win); } .fd.draw { background: #e2a12b; }
  .fd.point { background: var(--point); } .fd.none { background: var(--none); }

  .chip {
    display: inline-flex; align-items: center; gap: 4px; white-space: nowrap;
    border-radius: 999px; padding: 1px 8px; font-size: 0.72rem; font-weight: 500;
    background: var(--line-soft); color: var(--ink-2);
  }
  .chip.gold { background: var(--gold-bg); color: #8a6a10; }
  .chip.accent { background: var(--accent-bg); color: var(--accent); }

  .res {
    display: inline-flex; align-items: center; justify-content: center; gap: 4px;
    border-radius: 7px; padding: 2px 8px; font-size: 0.74rem; font-weight: 600;
  }
  .res.win   { background: var(--win-bg);   color: var(--win); }
  .res.draw  { background: var(--draw-bg);  color: var(--draw); }
  .res.point { background: var(--point-bg); color: var(--point); }
  .res.none  { background: var(--none-bg);  color: var(--none); }

  .rank {
    display: inline-flex; align-items: center; justify-content: center;
    min-width: 28px; height: 28px; padding: 0 6px; border-radius: 8px;
    font-weight: 600; font-size: 0.84rem; color: var(--ink-2); background: var(--line-soft);
  }
  .rank.r1 { background: var(--gold-bg);   color: var(--gold); }
  .rank.r2 { background: var(--silver-bg); color: var(--silver); }
  .rank.r3 { background: var(--bronze-bg); color: var(--bronze); }
  .move { font-size: 0.7rem; font-weight: 600; }

  .empty { color: var(--dim); font-size: 0.86rem; padding: 6px 0; }

  /* ===================== TOP 5 & HOUSE BARS (overview) ===================== */
  .mini-row {
    display: grid; grid-template-columns: 36px minmax(0,1fr) auto auto; align-items: center; gap: 12px;
    padding: 10px 6px; border-bottom: 1px solid var(--line-soft); cursor: pointer; border-radius: 8px;
  }
  .mini-row:last-child { border-bottom: none; }
  .mini-row:hover { background: #fafbfd; }
  .mini-name { display: flex; align-items: center; gap: 8px; font-weight: 600; min-width: 0; }
  .mini-name span.t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .mini-house { font-size: 0.76rem; color: var(--dim); font-weight: 400; }
  .mini-att { font-size: 0.82rem; color: var(--ink-2); }
  .mini-pts { font-weight: 700; min-width: 54px; text-align: right; }
  .mini-pts small { font-weight: 500; color: var(--dim); font-size: 0.74rem; margin-left: 2px; }

  .hbar { padding: 9px 4px; cursor: pointer; border-radius: 8px; }
  .hbar:hover { background: #fafbfd; }
  .hbar-top { display: flex; align-items: center; justify-content: space-between; gap: 8px; font-size: 0.86rem; }
  .hbar-top > b { font-weight: 600; display: flex; align-items: center; gap: 8px; }
  .hbar-top > span { white-space: nowrap; color: var(--ink-2); }
  .hbar-track { height: 8px; background: var(--line-soft); border-radius: 999px; margin-top: 7px; overflow: hidden; }
  .hbar-fill { height: 100%; border-radius: 999px; transition: width .6s ease; }

  /* ===================== POINTS KEY ===================== */
  .key-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; }
  .key-item { display: flex; align-items: center; gap: 12px; border-radius: 12px; padding: 12px 14px; }
  .key-item.win { background: var(--win-bg); } .key-item.draw { background: var(--draw-bg); }
  .key-item.point { background: var(--point-bg); } .key-item.none { background: var(--none-bg); }
  .key-pts { font-size: 1.6rem; font-weight: 700; line-height: 1; min-width: 26px; text-align: center; }
  .key-item.win .key-pts { color: var(--win); } .key-item.draw .key-pts { color: var(--draw); }
  .key-item.point .key-pts { color: var(--point); } .key-item.none .key-pts { color: var(--none); }
  .key-text b { display: block; font-size: 0.86rem; }
  .key-text span { font-size: 0.78rem; color: var(--ink-2); }
  .key-note { font-size: 0.8rem; color: var(--dim); margin-top: 12px; }

  /* ===================== LEAGUE TABLE ===================== */
  .table-card { padding: 0; overflow: hidden; }
  .t-head, .t-row {
    display: grid; grid-template-columns: 70px minmax(0,1fr) 70px 56px 76px 92px;
    align-items: center; gap: 10px; padding: 0 20px;
  }
  .t-head {
    font-size: 0.7rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase;
    color: var(--dim); background: #fafbfd; border-bottom: 1px solid var(--line); height: 42px;
  }
  .t-head .n, .t-row .n { text-align: center; }
  .t-head .p, .t-row .p { text-align: right; }
  .t-row { min-height: 68px; padding-top: 10px; padding-bottom: 10px; border-bottom: 1px solid var(--line-soft); cursor: pointer; transition: background .15s; }
  .t-row:last-child { border-bottom: none; }
  .t-row:hover { background: #fafbfd; }
  .c-pos { display: flex; align-items: center; gap: 6px; }
  .g-name { display: flex; align-items: center; gap: 8px; font-weight: 600; font-size: 0.94rem; flex-wrap: wrap; }
  .g-house { font-size: 0.76rem; font-weight: 400; color: var(--dim); }
  .g-meta { display: flex; align-items: center; gap: 8px; flex-wrap: wrap; margin-top: 5px; }
  .t-row .n { font-weight: 500; color: var(--ink-2); }
  .t-row .p b { font-size: 1.05rem; font-weight: 700; }
  .t-row .p span { display: block; font-size: 0.72rem; color: var(--dim); }

  /* ===================== HOUSES ===================== */
  .house-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(210px, 1fr)); gap: 16px; }
  .house-card { cursor: pointer; padding: 0; overflow: hidden; transition: border-color .15s, box-shadow .15s; }
  .house-card:hover { border-color: #cfd5e1; box-shadow: 0 6px 22px rgba(16,24,40,.08); }
  .house-strip { height: 6px; }
  .house-body { padding: 16px 18px 18px; }
  .house-top { display: flex; align-items: center; justify-content: space-between; }
  .house-name { font-weight: 700; font-size: 1.02rem; }
  .house-pts { font-size: 1.8rem; font-weight: 700; letter-spacing: -0.02em; margin-top: 8px; line-height: 1.1; }
  .house-pts small { font-size: 0.85rem; color: var(--dim); font-weight: 500; margin-left: 3px; }
  .house-stats { display: flex; gap: 14px; margin-top: 8px; font-size: 0.8rem; color: var(--ink-2); flex-wrap: wrap; }
  .house-link { margin-top: 12px; font-size: 0.8rem; font-weight: 600; color: var(--accent); }

  /* ===================== BADGES ===================== */
  .badge-list { display: flex; flex-direction: column; gap: 10px; }
  .badge-item { border: 1px solid var(--line); border-radius: 12px; background: var(--card); }
  .badge-item.locked { background: #fbfcfd; }
  .badge-item summary {
    list-style: none; display: grid; grid-template-columns: 40px minmax(0,1fr) auto 18px;
    align-items: center; gap: 12px; padding: 12px 14px; cursor: pointer;
  }
  .badge-item summary::-webkit-details-marker { display: none; }
  .badge-emoji { font-size: 1.5rem; text-align: center; }
  .badge-item.locked .badge-emoji { filter: grayscale(1); opacity: .45; }
  .badge-name { font-weight: 600; }
  .badge-desc { font-size: 0.8rem; color: var(--dim); }
  .badge-count { font-size: 0.8rem; color: var(--ink-2); white-space: nowrap; }
  .badge-chev { color: var(--dim); transition: transform .2s; }
  .badge-item[open] .badge-chev { transform: rotate(180deg); }
  .badge-winners { display: flex; flex-wrap: wrap; gap: 6px; padding: 0 14px 14px 66px; }
  .gchip {
    display: inline-flex; align-items: center; gap: 6px; background: var(--line-soft);
    border-radius: 999px; padding: 3px 10px; font-size: 0.78rem; font-weight: 500;
  }

  /* ===================== NEWS ===================== */
  .news-list { display: flex; flex-direction: column; gap: 8px; }
  .news-item { display: flex; gap: 12px; align-items: flex-start; padding: 10px 12px; border-radius: 10px; background: #fafbfd; border: 1px solid var(--line-soft); }
  .news-n { font-size: 0.74rem; font-weight: 600; color: var(--accent); background: var(--accent-bg); border-radius: 6px; padding: 2px 7px; flex-shrink: 0; margin-top: 1px; }
  .news-t { font-size: 0.9rem; }

  /* ===================== SETUP ===================== */
  .setup h2 { font-size: 1.15rem; margin-bottom: 6px; }
  .setup p { color: var(--ink-2); margin-bottom: 12px; }
  .setup ol { margin: 0 0 16px 20px; color: var(--ink-2); }
  .setup ol li { margin-bottom: 6px; }

  /* ===================== MODALS ===================== */
  .overlay {
    position: fixed; inset: 0; z-index: 500; display: none;
    background: rgba(17,24,39,.42); backdrop-filter: blur(2px);
    align-items: flex-start; justify-content: center; padding: 40px 16px; overflow-y: auto;
  }
  .overlay.open { display: flex; animation: fadeIn .18s ease-out; }
  @keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
  .modal {
    background: var(--card); border-radius: 18px; box-shadow: var(--shadow-lg);
    width: 100%; max-width: 560px; padding: 24px;
  }
  .modal-wide { max-width: 860px; }
  .modal h2 { font-size: 1.2rem; font-weight: 700; display: flex; align-items: center; gap: 10px; }
  .modal-sub { color: var(--dim); font-size: 0.85rem; margin: 4px 0 18px; }
  .modal-actions { display: flex; gap: 10px; margin-top: 18px; flex-wrap: wrap; }
  .modal-actions .btn { flex: 1; justify-content: center; }
  .input {
    width: 100%; border: 1px solid var(--line); border-radius: 10px; padding: 10px 12px;
    font-family: inherit; font-size: 0.9rem; color: var(--ink); background: #fff;
  }
  .input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-bg); }
  details.help summary { cursor: pointer; color: var(--accent); font-weight: 600; font-size: 0.84rem; margin-top: 14px; }
  details.help div { font-size: 0.84rem; color: var(--ink-2); margin-top: 10px; }
  details.help p { margin-bottom: 8px; }

  .stat-grid { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 10px; margin-bottom: 18px; }
  .stat { background: #fafbfd; border: 1px solid var(--line-soft); border-radius: 12px; padding: 12px; }
  .stat .v { font-size: 1.3rem; font-weight: 700; }
  .stat .l { font-size: 0.74rem; color: var(--dim); }

  .hg-row { border: 1px solid var(--line); border-radius: 12px; padding: 12px 14px; margin-bottom: 8px; cursor: pointer; }
  .hg-row:hover { background: #fafbfd; }
  .hg-top { display: grid; grid-template-columns: minmax(0,1fr) 60px 70px 60px; gap: 10px; align-items: center; }
  .hg-top .n { text-align: center; color: var(--ink-2); font-size: 0.85rem; }
  .hg-top .p { text-align: right; font-weight: 700; }
  .hg-weeks { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 10px; }
  .wk { display: inline-flex; flex-direction: column; align-items: center; min-width: 46px; border-radius: 8px; padding: 3px 4px; }
  .wk i { font-style: normal; font-size: 0.64rem; color: var(--dim); }
  .wk b { font-size: 0.78rem; font-weight: 600; }
  .wk.win { background: var(--win-bg); color: var(--win); } .wk.draw { background: var(--draw-bg); color: var(--draw); }
  .wk.point { background: var(--point-bg); color: var(--point); } .wk.none { background: var(--none-bg); color: var(--none); }
  .wk.blank { background: var(--line-soft); color: var(--dim); }

  /* ===================== TUTOR CARD ===================== */
  .tutor-card {
    background: var(--card); border: 1px solid var(--line); border-radius: 16px; padding: 18px;
    border-top: 5px solid var(--cc); break-inside: avoid; page-break-inside: avoid;
  }
  .tc-head { display: flex; align-items: center; gap: 12px; }
  .tc-name { font-weight: 700; font-size: 1.05rem; line-height: 1.2; }
  .tc-house { font-size: 0.8rem; color: var(--dim); }
  .tc-pos { margin-left: auto; text-align: right; }
  .tc-pos .n { font-weight: 700; font-size: 1.2rem; line-height: 1.1; }
  .tc-pos .l { font-size: 0.74rem; color: var(--dim); }
  .tc-stats { display: grid; grid-template-columns: repeat(4, minmax(0,1fr)); gap: 8px; margin: 14px 0; }
  .tc-stat { background: #fafbfd; border: 1px solid var(--line-soft); border-radius: 10px; padding: 8px; text-align: center; }
  .tc-stat .v { font-weight: 700; font-size: 1.05rem; }
  .tc-stat .l { font-size: 0.7rem; color: var(--dim); }
  .tc-spark { margin: 4px 0 10px; }
  .tc-section { font-size: 0.72rem; font-weight: 600; letter-spacing: 0.06em; text-transform: uppercase; color: var(--dim); margin: 14px 0 8px; }
  .tc-badges { display: flex; flex-wrap: wrap; gap: 6px; }
  .tc-badge-lg { display: flex; align-items: center; gap: 8px; border: 1px solid var(--line); border-radius: 10px; padding: 6px 10px; font-size: 0.8rem; }
  .tc-badge-lg i { font-style: normal; color: var(--dim); display: block; font-size: 0.74rem; }
  .tc-note { font-size: 0.82rem; color: var(--ink-2); background: #fafbfd; border: 1px solid var(--line-soft); border-radius: 10px; padding: 9px 11px; margin-top: 10px; }
  .tc-foot { font-size: 0.72rem; color: var(--dim); margin-top: 12px; }
  .tc-large { padding: 24px; }
  .tc-large .tc-name { font-size: 1.35rem; }
  .ledger { width: 100%; border-collapse: collapse; font-size: 0.84rem; }
  .ledger th { text-align: left; font-size: 0.7rem; font-weight: 600; letter-spacing: 0.05em; text-transform: uppercase; color: var(--dim); padding: 6px 8px; border-bottom: 1px solid var(--line); }
  .ledger td { padding: 7px 8px; border-bottom: 1px solid var(--line-soft); }
  .ledger .num { text-align: right; }
  .ledger tfoot td { font-weight: 700; border-bottom: none; padding-top: 10px; }

  /* ===================== FULL-SCREEN SHEETS (highlights, tutor cards) ===================== */
  .sheet-overlay {
    position: fixed; inset: 0; z-index: 600; display: none; overflow-y: auto;
    background: var(--bg); padding: 30px 20px 110px;
  }
  .sheet-overlay.open { display: block; animation: fadeIn .18s ease-out; }
  .sheet { max-width: 900px; margin: 0 auto; }
  .sheet-head { text-align: center; margin-bottom: 20px; }
  .sheet-head h2 { font-size: 1.6rem; font-weight: 700; }
  .sheet-head p { color: var(--dim); }
  .sheet-actions { position: fixed; bottom: 20px; left: 50%; transform: translateX(-50%); display: flex; gap: 10px; z-index: 610; }
  .sheet-actions .btn { box-shadow: var(--shadow-lg); }
  .cards-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 14px; }
  .hl-section { font-size: 0.74rem; font-weight: 600; letter-spacing: 0.07em; text-transform: uppercase; color: var(--dim); margin: 22px 0 10px; }
  .hl-row { display: flex; align-items: center; gap: 14px; }
  .hl-badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 10px; }

  /* ===================== ASSEMBLY REVEAL ===================== */
  .reveal-overlay {
    position: fixed; inset: 0; z-index: 700; display: none; flex-direction: column; align-items: center;
    background: var(--bg); padding: 40px 20px 30px; overflow-y: auto;
  }
  .reveal-overlay.open { display: flex; }
  .reveal-sub { font-size: 0.82rem; font-weight: 600; letter-spacing: 0.1em; text-transform: uppercase; color: var(--accent); }
  .reveal-heading { font-size: clamp(1.8rem, 4vw, 2.8rem); font-weight: 700; letter-spacing: -0.02em; margin: 6px 0 26px; text-align: center; }
  .reveal-stage { width: 100%; max-width: 760px; min-height: 260px; display: flex; align-items: center; justify-content: center; }
  .reveal-stage > * { animation: revealIn .35s ease-out; }
  @keyframes revealIn { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }
  .reveal-start { text-align: center; }
  .reveal-start p { color: var(--ink-2); margin-bottom: 20px; font-size: 1rem; }
  .reveal-inter { font-size: clamp(1.6rem, 4vw, 2.6rem); font-weight: 700; color: var(--ink-2); text-align: center; }
  .reveal-card {
    width: 100%; background: var(--card); border: 1px solid var(--line); border-left: 8px solid var(--rc);
    border-radius: 18px; box-shadow: var(--shadow); padding: 26px 30px; display: flex; align-items: center; gap: 26px;
  }
  .reveal-pos { font-size: 3rem; font-weight: 700; color: var(--dim); min-width: 110px; text-align: center; line-height: 1; }
  .reveal-name { font-size: clamp(1.6rem, 4vw, 2.4rem); font-weight: 700; line-height: 1.15; }
  .reveal-meta { display: flex; gap: 22px; margin-top: 8px; color: var(--ink-2); font-size: 1rem; flex-wrap: wrap; }
  .reveal-meta b { color: var(--ink); }
  .reveal-champ {
    width: 100%; text-align: center; background: var(--card); border: 1px solid var(--line);
    border-top: 8px solid var(--rc); border-radius: 22px; box-shadow: var(--shadow-lg); padding: 34px 26px;
  }
  .reveal-champ .trophy { font-size: 3.4rem; line-height: 1; }
  .reveal-champ .lab { font-size: 0.85rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--gold); margin-top: 10px; }
  .reveal-champ .nm { font-size: clamp(2rem, 5vw, 3.2rem); font-weight: 700; letter-spacing: -0.02em; margin: 6px 0 12px; line-height: 1.1; }
  .reveal-done { display: flex; flex-wrap: wrap; gap: 8px; justify-content: center; max-width: 900px; margin-top: 24px; }
  .reveal-done .gchip { background: var(--card); border: 1px solid var(--line); }
  .reveal-done .gchip b { color: var(--dim); font-weight: 600; }
  .reveal-hint { color: var(--dim); font-size: 0.85rem; margin-top: 14px; }
  .reveal-controls { display: flex; gap: 10px; margin-top: auto; padding-top: 26px; flex-wrap: wrap; justify-content: center; }

  /* ===================== KIOSK ===================== */
  .kiosk {
    position: fixed; inset: 0; z-index: 800; display: none; flex-direction: column;
    background: var(--bg); padding: 2.4vh 3vw;
  }
  .kiosk.open { display: flex; }
  .kiosk-top { display: flex; align-items: center; justify-content: space-between; gap: 20px; }
  .kiosk-brand { display: flex; align-items: center; gap: 14px; }
  .kiosk-brand .brand-mark { width: 52px; height: 52px; border-radius: 14px; }
  .kiosk-brand .brand-mark .ico { width: 28px; height: 28px; }
  .kiosk-title { font-size: clamp(1.4rem, 2.6vw, 2.4rem); font-weight: 700; letter-spacing: -0.02em; }
  .kiosk-meta { font-size: clamp(0.9rem, 1.2vw, 1.15rem); color: var(--dim); }
  .kiosk-clock { font-size: clamp(1.6rem, 3vw, 2.8rem); font-weight: 600; color: var(--ink-2); font-variant-numeric: tabular-nums; }
  .kiosk-exit { position: fixed; top: 14px; right: 14px; width: 34px; height: 34px; border-radius: 50%; border: 1px solid var(--line); background: var(--card); color: var(--dim); cursor: pointer; opacity: .35; }
  .kiosk-exit:hover { opacity: 1; }
  .kiosk-slide-title { font-size: clamp(1.2rem, 2vw, 1.9rem); font-weight: 700; margin: 2.4vh 0 1.6vh; }
  .kiosk-body { flex: 1; min-height: 0; overflow: hidden; }
  .kiosk-slide { height: 100%; transition: opacity .45s ease; }
  .kiosk-slide.fading { opacity: 0; }
  .kiosk-rows { display: flex; flex-direction: column; gap: 1vh; }
  .kiosk-cols { display: grid; grid-template-columns: 1fr 1fr; gap: 1vh 1.6vw; }
  .k-row {
    display: grid; grid-template-columns: 5vw minmax(0,1fr) auto auto; align-items: center; gap: 1.6vw;
    background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow);
    padding: 1.05vh 1.6vw; font-size: clamp(1rem, 1.8vw, 1.7rem);
  }
  .kiosk-cols .k-row { font-size: clamp(0.9rem, 1.35vw, 1.3rem); padding: 0.8vh 1.2vw; }
  .k-row .chip { font-size: 0.55em; }
  .k-row .rank { min-width: 2.2em; height: 1.8em; font-size: 0.85em; border-radius: 10px; }
  .k-name { font-weight: 600; display: flex; align-items: center; gap: 0.6em; min-width: 0; }
  .k-name .t { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
  .k-name .h { font-weight: 400; color: var(--dim); font-size: 0.7em; }
  .k-att { color: var(--ink-2); font-size: 0.85em; }
  .k-pts { font-weight: 700; min-width: 4.2em; text-align: right; }
  .k-pts small { font-weight: 500; color: var(--dim); font-size: 0.6em; margin-left: 3px; }
  .k-houses { display: grid; grid-template-columns: repeat(auto-fit, minmax(16vw, 1fr)); gap: 1.6vw; }
  .k-house { background: var(--card); border: 1px solid var(--line); border-radius: 18px; box-shadow: var(--shadow); overflow: hidden; }
  .k-house .house-strip { height: 1.2vh; }
  .k-house-body { padding: 2.4vh 1.6vw; }
  .k-house-body .pos { font-size: clamp(0.9rem, 1.2vw, 1.2rem); color: var(--dim); font-weight: 600; }
  .k-house-body .nm { font-size: clamp(1.4rem, 2.4vw, 2.4rem); font-weight: 700; }
  .k-house-body .pts { font-size: clamp(2rem, 4vw, 4rem); font-weight: 700; letter-spacing: -0.02em; line-height: 1.1; margin-top: 1vh; }
  .k-house-body .pts small { font-size: 0.4em; color: var(--dim); font-weight: 500; margin-left: 4px; }
  .k-house-body .avg { font-size: clamp(0.9rem, 1.3vw, 1.3rem); color: var(--ink-2); }
  .k-news { display: flex; flex-direction: column; gap: 1.4vh; }
  .k-news div { background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); padding: 1.8vh 1.8vw; font-size: clamp(1rem, 1.9vw, 1.8rem); }
  .k-badges { display: grid; grid-template-columns: repeat(auto-fill, minmax(26vw, 1fr)); gap: 1.4vh 1.4vw; }
  .k-badge { background: var(--card); border: 1px solid var(--line); border-radius: 14px; box-shadow: var(--shadow); padding: 1.6vh 1.4vw; }
  .k-badge .hd { display: flex; align-items: center; gap: 0.6em; font-size: clamp(1rem, 1.5vw, 1.5rem); font-weight: 700; }
  .k-badge .ds { font-size: clamp(0.8rem, 1vw, 1rem); color: var(--dim); }
  .k-badge .ws { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 1vh; }
  .k-badge .gchip { font-size: clamp(0.75rem, 0.95vw, 0.95rem); }
  .kiosk-dots { display: flex; justify-content: center; gap: 8px; padding-top: 1.6vh; }
  .kiosk-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--line); transition: background .3s, width .3s; }
  .kiosk-dot.on { background: var(--accent); width: 26px; border-radius: 999px; }

  /* ===================== TOAST ===================== */
  .toast {
    position: fixed; bottom: 24px; left: 50%; transform: translate(-50%, 140%);
    background: var(--ink); color: #fff; border-radius: 10px; padding: 10px 18px;
    font-size: 0.86rem; z-index: 900; transition: transform .25s ease, opacity .25s; box-shadow: var(--shadow-lg);
    opacity: 0; visibility: hidden;
  }
  .toast.show { transform: translate(-50%, 0); opacity: 1; visibility: visible; }

  /* ===================== RESPONSIVE ===================== */
  @media (max-width: 1100px) {
    .grid-kpi { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .grid-2 { grid-template-columns: minmax(0,1fr); }
  }
  @media (max-width: 860px) {
    .app { grid-template-columns: 1fr; }
    .rail { position: sticky; top: 0; z-index: 50; height: auto; flex-direction: row; align-items: center; padding: 8px 10px; overflow-x: auto; border-right: none; border-bottom: 1px solid var(--line); }
    .brand { padding: 0 8px 0 0; }
    .brand-title, .brand-sub, .nav-label { display: none; }
    .rail nav { display: flex; gap: 2px; }
    .nav-item { width: auto; white-space: nowrap; padding: 8px 10px; }
    .rail-foot { margin: 0 0 0 4px; padding: 0; border: none; display: flex; }
    .credit-btn, .credit-popup { display: none; }
    .main { padding: 18px 14px 50px; }
    .key-grid { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .t-head, .t-row { grid-template-columns: 52px minmax(0,1fr) 64px 64px; padding-left: 12px; padding-right: 12px; }
    .hide-sm { display: none; }
    .stat-grid, .tc-stats { grid-template-columns: repeat(2, minmax(0,1fr)); }
    .reveal-card { flex-direction: column; text-align: center; gap: 10px; }
    .kiosk-cols { grid-template-columns: 1fr; }
  }

  /* ===================== PRINT ===================== */
  @media print {
    html, body { background: #fff; }
    body { -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .rail, .top-actions, .admin-bar, .toast, .overlay, .sheet-overlay, .reveal-overlay, .kiosk, .sheet-actions { display: none !important; }
    .app { display: block; }
    .main { padding: 0; }
    .card, .tutor-card { box-shadow: none; }
    .t-row, .card, .house-card, .badge-item { break-inside: avoid; }
    .view { animation: none; }

    body.printing-group > *:not(#detailOverlay) { display: none !important; }
    body.printing-group #detailOverlay { display: block !important; position: static; background: none; padding: 0; backdrop-filter: none; }
    body.printing-group #detailOverlay .modal { box-shadow: none; max-width: 100%; padding: 0; }
    body.printing-group #detailOverlay .modal-actions { display: none; }

    body.printing-sheet > *:not(.sheet-overlay.open) { display: none !important; }
    body.printing-sheet .sheet-overlay.open { display: block !important; position: static; padding: 0; background: #fff; overflow: visible; }
    body.printing-sheet .sheet-actions { display: none !important; }
  }
</style>
</head>
<body>

<div class="app">

  <!-- ===================== LEFT RAIL ===================== -->
  <aside class="rail">
    <div class="brand">
      <div class="brand-mark" data-ico="trophy"></div>
      <div>
        <div class="brand-title" id="brandTitle">Attendance League</div>
        <div class="brand-sub">Weekly points</div>
      </div>
    </div>

    <nav>
      <div class="nav-label">League</div>
      <button class="nav-item active" data-view="overview" onclick="showView('overview')"><span data-ico="grid"></span>Overview</button>
      <button class="nav-item" data-view="table"    onclick="showView('table')"><span data-ico="list"></span>League table</button>
      <button class="nav-item" data-view="houses"   onclick="showView('houses')"><span data-ico="shield"></span>Houses</button>
      <button class="nav-item" data-view="badges"   onclick="showView('badges')"><span data-ico="award"></span>Badges</button>
      <button class="nav-item" data-view="news"     onclick="showView('news')"><span data-ico="news"></span>League news</button>

      <div class="nav-label">Display</div>
      <button class="nav-item" onclick="openKiosk()"><span data-ico="tv"></span>Kiosk mode</button>
      <button class="nav-item" onclick="openReveal()"><span data-ico="trophy"></span>Assembly reveal</button>
      <button class="nav-item" onclick="openHighlights()"><span data-ico="star"></span>Highlights</button>
    </nav>

    <div class="rail-foot">
      <button class="nav-item" id="showAdminBtn" onclick="toggleAdmin()"><span data-ico="sliders"></span>Admin</button>
      <button class="credit-btn" onclick="toggleCredit()" title="About the build">i</button>
      <div class="credit-popup" id="creditPopup">Built by dhdataworks@gmail.com</div>
    </div>
  </aside>

  <!-- ===================== MAIN ===================== -->
  <main class="main">

    <header class="topbar">
      <div>
        <h1 id="viewTitle">Overview</h1>
        <div class="status-line" id="statusLine"></div>
      </div>
      <div class="top-actions">
        <button class="btn" onclick="printPage()"><span data-ico="print"></span>Print</button>
      </div>
    </header>

    <div class="admin-bar" id="adminBar" hidden>
      <span class="admin-tag">Admin</span>
      <button class="btn btn-sm" onclick="openDataSource()"><span data-ico="link"></span>Data source</button>
      <button class="btn btn-sm" onclick="refreshData()"><span data-ico="refresh"></span>Refresh</button>
      <button class="btn btn-sm" onclick="openTutorCards()"><span data-ico="idcard"></span>Tutor cards</button>
      <div class="entry-tracker">
        <span id="weekCompletion">—</span>
        <div class="entry-bar"><div class="entry-bar-fill" id="entryBarFill"></div></div>
      </div>
    </div>

    <div id="setupState"></div>

    <div id="dashboard" hidden>

      <!-- OVERVIEW -->
      <section class="view" id="view-overview">
        <div class="grid grid-kpi" id="kpiRow"></div>
        <div class="grid grid-2">
          <div class="card">
            <div class="card-head">
              <div><div class="card-title">Top 5</div><div class="card-hint">Click a group to see its card</div></div>
              <button class="btn btn-sm" onclick="showView('table')">Full table</button>
            </div>
            <div id="top5"></div>
          </div>
          <div class="card" id="houseStandingsCard">
            <div class="card-head">
              <div><div class="card-title">House standings</div><div class="card-hint">Total points of every group in the house</div></div>
              <button class="btn btn-sm" onclick="showView('houses')">Houses</button>
            </div>
            <div id="houseBars"></div>
          </div>
        </div>
        <div class="card">
          <div class="card-head">
            <div><div class="card-title">League news</div><div class="card-hint" id="newsHint">—</div></div>
            <button class="btn btn-sm" onclick="showView('news')">All headlines</button>
          </div>
          <div class="news-list" id="newsPreview"></div>
        </div>
      </section>

      <!-- LEAGUE TABLE -->
      <section class="view" id="view-table" hidden>
        <div class="card">
          <div class="card-head" style="margin-bottom:12px"><div class="card-title">How points are scored each week</div></div>
          <div class="key-grid">
            <div class="key-item win"><div class="key-pts">3</div><div class="key-text"><b>Win</b><span>95% and above</span></div></div>
            <div class="key-item draw"><div class="key-pts">2</div><div class="key-text"><b>Draw</b><span>90% – 94.9%</span></div></div>
            <div class="key-item point"><div class="key-pts">1</div><div class="key-text"><b>Point</b><span>75% – 89.9%</span></div></div>
            <div class="key-item none"><div class="key-pts">0</div><div class="key-text"><b>No points</b><span>Below 75%</span></div></div>
          </div>
          <div class="key-note">Groups are ranked on total points. If two groups are level, the higher average attendance goes above. Badges are for recognition and don't add points.</div>
        </div>
        <div class="card table-card">
          <div class="t-head">
            <div>#</div>
            <div>Group</div>
            <div class="n hide-sm">Weeks</div>
            <div class="n hide-sm">Wins</div>
            <div class="n">Att %</div>
            <div class="p">Points</div>
          </div>
          <div id="tableBody"></div>
        </div>
      </section>

      <!-- HOUSES -->
      <section class="view" id="view-houses" hidden>
        <div class="house-grid" id="houseGrid"></div>
      </section>

      <!-- BADGES -->
      <section class="view" id="view-badges" hidden>
        <div class="card">
          <div class="card-head">
            <div><div class="card-title">Attendance badges</div><div class="card-hint">Open a badge to see which groups have earned it</div></div>
            <button class="btn btn-sm" id="badgeToggle" onclick="toggleAllBadges()">Expand all</button>
          </div>
          <div class="badge-list" id="badgeBoard"></div>
        </div>
      </section>

      <!-- NEWS -->
      <section class="view" id="view-news" hidden>
        <div class="card">
          <div class="card-head"><div><div class="card-title">League news</div><div class="card-hint" id="newsListSub">—</div></div></div>
          <div class="news-list" id="newsList"></div>
        </div>
      </section>

    </div>
  </main>
</div>

<!-- TOAST -->
<div class="toast" id="toast"></div>

<!-- ============ MODALS ============ -->

<!-- PIN -->
<div class="overlay" id="pinOverlay">
  <div class="modal" style="max-width:340px;text-align:center;margin-top:10vh">
    <h2 style="justify-content:center">Enter PIN</h2>
    <div class="modal-sub">Admin access required</div>
    <input type="password" class="input" id="pinInput" inputmode="numeric" maxlength="8" style="text-align:center;font-size:1.3rem;letter-spacing:0.3em" onkeydown="if(event.key==='Enter')submitPin()">
    <div class="modal-actions">
      <button class="btn btn-primary" onclick="submitPin()">Unlock</button>
      <button class="btn" onclick="closePin()">Cancel</button>
    </div>
  </div>
</div>

<!-- DATA SOURCE -->
<div class="overlay" id="dataSourceOverlay">
  <div class="modal" style="margin-top:6vh">
    <h2>Data source</h2>
    <div class="modal-sub">Connect the dashboard to your published Google Sheet</div>
    <p style="font-size:0.86rem;color:var(--ink-2);margin-bottom:10px">Paste the <b>published CSV link</b> from your Google Sheet (File → Share → Publish to web → CSV).</p>
    <input type="text" class="input" id="sheetUrlInput" placeholder="https://docs.google.com/spreadsheets/d/e/..../pub?output=csv">
    <div class="modal-actions">
      <button class="btn btn-primary" onclick="saveDataSource()">Connect &amp; load</button>
      <button class="btn" onclick="closeDataSource()">Cancel</button>
    </div>
    <details class="help">
      <summary>How to set up the sheet</summary>
      <div>
        <p>Row 1 holds the headings: <b>Group</b> · <b>House</b> · <b>Colour</b> · <b>Emoji</b> · <b>Week 1</b> · <b>Week 2</b> · … (add as many week columns as you need).</p>
        <p>One row per group. Leave <b>House</b> blank if you're not using houses. <b>Colour</b> and <b>Emoji</b> are optional. Type attendance percentages into the week columns as they happen.</p>
        <p>Then: File → Share → <b>Publish to web</b> → choose the sheet → <b>Comma-separated values (.csv)</b> → Publish → copy the link.</p>
        <button class="btn btn-sm" onclick="downloadTemplate()">Download sheet template (CSV)</button>
      </div>
    </details>
  </div>
</div>

<!-- GROUP DETAIL (the group's card, full size) -->
<div class="overlay" id="detailOverlay">
  <div class="modal modal-wide">
    <div id="detailCard"></div>
    <div class="modal-actions">
      <button class="btn" onclick="printGroup()"><span data-ico="print"></span>Print this card</button>
      <button class="btn" onclick="closeDetail()">Close</button>
    </div>
  </div>
</div>

<!-- HOUSE DETAIL -->
<div class="overlay" id="houseDetailOverlay">
  <div class="modal modal-wide">
    <h2 id="houseDetailName">—</h2>
    <div class="modal-sub" id="houseDetailSub">—</div>
    <div class="stat-grid" id="houseDetailStats"></div>
    <div class="tc-section" style="margin-top:0">Groups in this house</div>
    <div id="houseGroupsList"></div>
    <div class="modal-actions"><button class="btn" onclick="closeHouseDetail()">Close</button></div>
  </div>
</div>

<!-- HIGHLIGHTS -->
<div class="sheet-overlay" id="highlightsOverlay">
  <div class="sheet" id="highlightsSheet"></div>
  <div class="sheet-actions">
    <button class="btn btn-primary" onclick="printSheet()"><span data-ico="print"></span>Print / save PDF</button>
    <button class="btn" onclick="closeHighlights()">Close</button>
  </div>
</div>

<!-- TUTOR CARDS -->
<div class="sheet-overlay" id="cardsOverlay">
  <div class="sheet" style="max-width:1100px">
    <div class="sheet-head">
      <h2>Tutor cards</h2>
      <p>One card per group. Print and hand to form tutors, or show on the tutor-room screen.</p>
    </div>
    <div class="cards-grid" id="cardsGrid"></div>
  </div>
  <div class="sheet-actions">
    <button class="btn btn-primary" onclick="printSheet()"><span data-ico="print"></span>Print / save PDF</button>
    <button class="btn" onclick="closeTutorCards()">Close</button>
