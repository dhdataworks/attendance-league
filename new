// ===================== ASSEMBLY REVEAL =====================
// Reveals the table from last place up to the champions.
let reveal = { open: false, started: false, finished: false, paused: false, auto: true, steps: [], idx: -1, timer: null, last: null };
let soundOn = true;
let audioCtx = null;
function ac() {
  try {
    if (!audioCtx) audioCtx = new (window.AudioContext || window.webkitAudioContext)();
    if (audioCtx.state === 'suspended') audioCtx.resume();
    return audioCtx;
  } catch (e) { return null; }
}
function tone(freq, dur, vol, when) {
  if (!soundOn) return;
  const ctx = ac(); if (!ctx) return;
  const o = ctx.createOscillator(), g = ctx.createGain();
  o.type = 'sine'; o.frequency.value = freq;
  o.connect(g); g.connect(ctx.destination);
  const t = ctx.currentTime + (when || 0);
  g.gain.setValueAtTime(0.0001, t);
  g.gain.exponentialRampToValueAtTime(vol || 0.12, t + 0.015);
  g.gain.exponentialRampToValueAtTime(0.0001, t + (dur || 0.2));
  o.start(t); o.stop(t + (dur || 0.2) + 0.05);
}
function drumroll(duration) {
  if (!soundOn) return;
  const ctx = ac(); if (!ctx) return;
  const n = Math.floor(ctx.sampleRate * duration);
  const buf = ctx.createBuffer(1, n, ctx.sampleRate), d = buf.getChannelData(0);
  for (let i = 0; i < n; i++) d[i] = Math.random() * 2 - 1;
  const src = ctx.createBufferSource(); src.buffer = buf;
  const filt = ctx.createBiquadFilter(); filt.type = 'lowpass'; filt.frequency.value = 800;
  const g = ctx.createGain(); g.gain.value = 0;
  const t = ctx.currentTime, hits = Math.floor(duration * 15), step = duration / hits;
  for (let i = 0; i < hits; i++) {
    const ht = t + i * step;
    g.gain.setValueAtTime(0.001, ht);
    g.gain.exponentialRampToValueAtTime(0.22, ht + 0.012);
    g.gain.exponentialRampToValueAtTime(0.001, ht + step * 0.85);
  }
  src.connect(filt); filt.connect(g); g.connect(ctx.destination);
  src.start(t); src.stop(t + duration);
}
function fanfare() {
  [523.25, 659.25, 783.99, 1046.5].forEach((f, i) => tone(f, 0.22, 0.12, i * 0.14));
  [523.25, 659.25, 783.99].forEach(f => tone(f, 1.0, 0.08, 0.62));
}

function openReveal() {
  const sorted = getSortedClasses().filter(c => getStats(c).played > 0);
  if (!sorted.length) { toast('No results to reveal yet'); return; }
  const steps = [];
  sorted.map((c, i) => ({ cls: c, pos: i + 1 })).reverse().forEach(o => {
    if (o.pos === 3) steps.push({ type: 'inter', text: 'In third place…' });
    if (o.pos === 2) steps.push({ type: 'inter', text: 'In second place…' });
    if (o.pos === 1) steps.push({ type: 'inter', text: 'And your champions are…' });
    steps.push({ type: o.pos === 1 ? 'champ' : 'card', cls: o.cls, pos: o.pos, total: sorted.length });
  });
  reveal = { open: true, started: false, finished: false, paused: false, auto: true, steps, idx: -1, timer: null, last: null };
  document.getElementById('revealSub').textContent = settings.title || 'Attendance League';
  document.getElementById('revealDone').innerHTML = '';
  document.getElementById('revealHint').hidden = true;
  document.getElementById('revealStage').innerHTML = `<div class="reveal-start">
    <p>${sorted.length} groups, revealed from ${sorted.length}${ordSuffix(sorted.length)} place up to 1st.</p>
    <div style="display:flex;gap:10px;justify-content:center;flex-wrap:wrap">
      <button class="btn btn-primary" onclick="startReveal(true)">Start the reveal</button>
      <button class="btn" onclick="startReveal(false)">Click to advance</button>
    </div></div>`;
  document.getElementById('revealOverlay').classList.add('open');
  renderRevealControls();
}
function renderRevealControls() {
  const c = document.getElementById('revealControls');
  const sound = `<button class="btn" onclick="soundOn=!soundOn;renderRevealControls()">${soundOn ? 'Sound on' : 'Sound off'}</button>`;
  if (!reveal.started) c.innerHTML = `${sound}<button class="btn" onclick="closeReveal()">Close</button>`;
  else if (reveal.finished) c.innerHTML = `<button class="btn btn-primary" onclick="openReveal()">Run it again</button><button class="btn" onclick="closeReveal()">Close</button>`;
  else c.innerHTML = `${reveal.auto ? `<button class="btn" onclick="toggleRevealPause()">${reveal.paused ? 'Resume' : 'Pause'}</button>` : ''}
    <button class="btn" onclick="skipToChampion()">Skip to champions</button>${sound}<button class="btn" onclick="closeReveal()">Close</button>`;
}
function toggleRevealPause() {
  reveal.paused = !reveal.paused;
  if (!reveal.paused) scheduleRevealStep(500); else clearTimeout(reveal.timer);
  renderRevealControls();
}
function startReveal(auto) {
  ac();
  reveal.started = true; reveal.auto = auto;
  document.getElementById('revealHint').hidden = auto;
  renderRevealControls();
  if (auto) scheduleRevealStep(400); else revealStep();
}
function revealAdvance() {
  if (!reveal.started || reveal.finished || reveal.paused) return;
  clearTimeout(reveal.timer);
  revealStep();
}
function scheduleRevealStep(delay) {
  clearTimeout(reveal.timer);
  if (reveal.auto && !reveal.paused) reveal.timer = setTimeout(revealStep, delay);
}
function stashLast() {
  if (!reveal.last) return;
  const { cls, pos } = reveal.last;
  document.getElementById('revealDone').insertAdjacentHTML('afterbegin',
    `<span class="gchip"><b>${pos}${ordSuffix(pos)}</b><span class="dot" style="background:${cls.colour}"></span>${nm(cls)}</span>`);
  reveal.last = null;
}
function revealStep() {
  reveal.idx++;
  const step = reveal.steps[reveal.idx];
  if (!step) return;
  const stage = document.getElementById('revealStage');
  stashLast();
  if (step.type === 'inter') {
    const champ = step.text.includes('champions');
    stage.innerHTML = `<div class="reveal-inter">${step.text}</div>`;
    drumroll(champ ? 2.2 : 1.6);
    scheduleRevealStep(champ ? 2400 : 1900);
  } else if (step.type === 'card') {
    const s = getStats(step.cls);
    const medal = step.pos === 2 ? '🥈 ' : step.pos === 3 ? '🥉 ' : '';
    stage.innerHTML = `<div class="reveal-card" style="--rc:${step.cls.colour}">
      <div class="reveal-pos">${step.pos}${ordSuffix(step.pos)}</div>
      <div style="min-width:0">
        <div class="reveal-name">${medal}${nm(step.cls)}</div>
        <div class="reveal-meta"><span><b>${s.pts}</b> points</span><span><b>${pct(s.overallPct)}</b> average</span>${step.cls.house ? `<span>${esc(step.cls.house)}</span>` : ''}</div>
      </div></div>`;
    reveal.last = { cls: step.cls, pos: step.pos };
    tone(300 + (step.total - step.pos) * (500 / step.total), 0.16, 0.1);
    scheduleRevealStep(step.pos > 10 ? 1100 : step.pos > 3 ? 1600 : 2400);
  } else {
    const s = getStats(step.cls);
    stage.innerHTML = `<div class="reveal-champ" style="--rc:${step.cls.colour}">
      <div class="trophy">🏆</div>
      <div class="lab">Your champions</div>
      <div class="nm">${nm(step.cls)}</div>
      <div class="reveal-meta" style="justify-content:center"><span><b>${s.pts}</b> points</span><span><b>${pct(s.overallPct)}</b> average</span><span><b>${s.wins}</b> wins</span>${step.cls.house ? `<span>${esc(step.cls.house)}</span>` : ''}</div>
    </div>`;
    reveal.finished = true;
    document.getElementById('revealHint').hidden = true;
    fanfare();
    renderRevealControls();
  }
}
function skipToChampion() {
  clearTimeout(reveal.timer);
  stashLast();
  for (let i = reveal.idx + 1; i < reveal.steps.length; i++) {
    const st = reveal.steps[i];
    if (st.type === 'card') { reveal.last = { cls: st.cls, pos: st.pos }; stashLast(); }
  }
  reveal.idx = reveal.steps.findIndex(s => s.type === 'champ') - 1;
  revealStep();
}
function closeReveal() {
  clearTimeout(reveal.timer);
  reveal.open = false; reveal.started = false;
  document.getElementById('revealOverlay').classList.remove('open');
}

// ===================== KIOSK MODE =====================
// Full-screen display for corridor screens: cycles views every 12 seconds and
// re-reads the sheet every 5 minutes.
let kiosk = { open: false, idx: 0, slideTimer: null, clockTimer: null, refreshTimer: null, slides: [] };
const KIOSK_SLIDE_MS = 12000, KIOSK_REFRESH_MS = 5 * 60 * 1000;

function kioskRow(c, pos) {
  const s = getStats(c);
  return `<div class="k-row">
    ${rankBadge(pos, true)}
    <div class="k-name"><span class="dot" style="background:${c.colour}"></span><span class="t">${nm(c)}</span>${c.house ? `<span class="h">${esc(c.house)}</span>` : ''}${s.streak >= 2 ? `<span class="chip">🔥 ${s.streak}</span>` : ''}</div>
    <div class="k-att">${pct(s.overallPct)}</div>
    <div class="k-pts">${s.pts}<small>pts</small></div>
  </div>`;
}
function buildKioskSlides() {
  const slides = [];
  const sorted = getSortedClasses().filter(c => getStats(c).played > 0);
  if (!sorted.length) return slides;
  slides.push({ title: 'Top of the league', html: `<div class="kiosk-rows">${sorted.slice(0, 10).map((c, i) => kioskRow(c, i + 1)).join('')}</div>` });
  // the rest of the table, split evenly into pages of no more than 20 so every group gets screen time
  const rest = sorted.length - 10;
  const perPage = rest > 0 ? Math.ceil(rest / Math.ceil(rest / 20)) : 20;
  for (let start = 10; start < sorted.length; start += perPage) {
    const end = Math.min(start + perPage, sorted.length);
    slides.push({ title: `Places ${start + 1} to ${end}`, html: `<div class="kiosk-cols">${sorted.slice(start, end).map((c, i) => kioskRow(c, start + i + 1)).join('')}</div>` });
  }
  if (usingHouses) {
    const hs = getHouseStats();
    if (hs.length) slides.push({ title: 'House race', html: `<div class="k-houses">${hs.map((h, i) => `
      <div class="k-house"><div class="house-strip" style="background:${h.colour}"></div>
        <div class="k-house-body"><div class="pos">${i + 1}${ordSuffix(i + 1)}</div><div class="nm">${esc(h.name)}</div>
        <div class="pts">${h.pts}<small>pts</small></div><div class="avg">${pct(h.avg)} average</div></div></div>`).join('')}</div>` });
  }
  const lines = buildNewsLines();
  if (lines.length) slides.push({ title: 'League news', html: `<div class="k-news">${lines.slice(0, 5).map(l => `<div>${l}</div>`).join('')}</div>` });
  const earned = BADGES.map(b => ({ b, winners: sorted.filter(c => b.check(entriesUpTo(c))) })).filter(x => x.winners.length);
  if (earned.length) slides.push({ title: 'Badge winners', html: `<div class="k-badges">${earned.map(({ b, winners }) => `
    <div class="k-badge"><div class="hd">${b.emoji} ${b.name}</div><div class="ds">${b.desc}</div>
      <div class="ws">${winners.map(c => `<span class="gchip"><span class="dot" style="background:${c.colour}"></span>${nm(c)}</span>`).join('')}</div></div>`).join('')}</div>` });
  return slides;
}
function openKiosk() {
  kiosk.slides = buildKioskSlides();
  if (!kiosk.slides.length) { toast('No data to display yet'); return; }
  kiosk.open = true; kiosk.idx = 0;
  document.getElementById('kioskTitle').textContent = settings.title || 'Attendance League';
  updateKioskMeta();
  document.getElementById('kioskOverlay').classList.add('open');
  try { document.documentElement.requestFullscreen && document.documentElement.requestFullscreen(); } catch (e) {}
  showKioskSlide(0, true);
  tickKioskClock();
  kiosk.clockTimer = setInterval(tickKioskClock, 1000);
  kiosk.slideTimer = setInterval(() => showKioskSlide((kiosk.idx + 1) % kiosk.slides.length), KIOSK_SLIDE_MS);
  kiosk.refreshTimer = setInterval(async () => {
    const url = effectiveSheetUrl();
    if (!url) return;
    try {
      await loadFromSheet(url, { silent: true });
      render();
      kiosk.slides = buildKioskSlides();
      updateKioskMeta();
      showKioskSlide(Math.min(kiosk.idx, kiosk.slides.length - 1), true);
    } catch (e) {}
  }, KIOSK_REFRESH_MS);
}
function updateKioskMeta() {
  const lw = latestWeekWithData();
  document.getElementById('kioskMeta').textContent = lw ? `After Week ${lw} · 3 points for a win (95%+)` : '';
}
function tickKioskClock() {
  document.getElementById('kioskClock').textContent = new Date().toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
}
function showKioskSlide(i, instant) {
  const slide = kiosk.slides[i];
  if (!slide) return;
  kiosk.idx = i;
  const el = document.getElementById('kioskSlide');
  const swap = () => {
    document.getElementById('kioskSlideTitle').textContent = slide.title;
    el.innerHTML = slide.html;
    document.getElementById('kioskDots').innerHTML = kiosk.slides.map((_, d) => `<div class="kiosk-dot${d === i ? ' on' : ''}"></div>`).join('');
    el.classList.remove('fading');
  };
  if (instant) { swap(); return; }
  el.classList.add('fading');
  setTimeout(swap, 450);
}
function closeKiosk() {
  kiosk.open = false;
  clearInterval(kiosk.slideTimer); clearInterval(kiosk.clockTimer); clearInterval(kiosk.refreshTimer);
  document.getElementById('kioskOverlay').classList.remove('open');
  try { if (document.fullscreenElement) document.exitFullscreen(); } catch (e) {}
}

// ===================== KEYBOARD =====================
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') {
    if (reveal.open) return closeReveal();
    if (kiosk.open) return closeKiosk();
    ['detailOverlay', 'houseDetailOverlay', 'dataSourceOverlay', 'highlightsOverlay', 'cardsOverlay'].forEach(id => document.getElementById(id).classList.remove('open'));
    closePin();
  }
  if ((e.key === ' ' || e.key === 'Enter') && reveal.open && reveal.started && !reveal.finished && !e.target.closest('button')) {
    e.preventDefault();
    revealAdvance();
  }
});
// Click anywhere on the reveal background to advance (tap-to-advance mode)
document.getElementById('revealOverlay').addEventListener('click', e => {
  if (e.target.closest('button')) return;
  if (reveal.started && !reveal.finished) revealAdvance();
});
// Click outside a modal to close it
document.querySelectorAll('.overlay').forEach(o => o.addEventListener('click', e => {
  if (e.target === o && o.id !== 'pinOverlay') o.classList.remove('open');
}));

// ===================== INIT =====================
async function init() {
  loadSettings();
  paintIcons();
  render();
  const url = effectiveSheetUrl();
  if (url) {
    try { await loadFromSheet(url, { silent: true }); }
    catch (e) {}
    render();
  }
}
window.addEventListener('DOMContentLoaded', init);
</script>
