    <div class="tc-note">🎯 This week: ${groupMission(s)}</div>
    ${next ? `<div class="tc-note">🏅 Next badge to aim for: <b>${next.emoji} ${next.name}</b> (${next.desc})</div>` : ''}
    <div class="tc-foot">${esc(settings.title || 'Attendance League')}${latestWeekWithData() ? ' · after Week ' + latestWeekWithData() : ''}</div>
  </div>`;
}

