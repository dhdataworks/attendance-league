<script>
// ===================== CONFIG =====================

// ┌───────────────────────────────────────────────────────────────────┐
// │  BUILT-IN GOOGLE SHEET LINK                                        │
// │  Paste your published CSV link between the quotes below.           │
// │  Once set, EVERY device that opens this page connects              │
// │  automatically — no need to link the sheet on each device.        │
// │  (File → Share → Publish to web → CSV → copy the link.)           │
// └───────────────────────────────────────────────────────────────────┘
const BUILT_IN_SHEET_URL = 'https://docs.google.com/spreadsheets/d/e/2PACX-1vTJvuGkKmhv26IeA0Qs-JRyXSx08J_5vvIHxIACbCZ47koo5KWWpCLCZHwYmNOuZRMPrejJgvgPCzgE/pub?gid=0&single=true&output=csv';

const STORAGE_KEY = 'attendance_league_clean_v1';
const DEFAULT_PIN = '1234';

// ===================== POINTS =====================
// One result per week, scored on that week's attendance.
const BANDS = [
  { min: 95, key: 'win',   label: 'Win',       pts: 3 },
  { min: 90, key: 'draw',  label: 'Draw',      pts: 2 },
  { min: 75, key: 'point', label: 'Point',     pts: 1 },
  { min: 0,  key: 'none',  label: 'No points', pts: 0 },
];
function bandFor(pct) { return BANDS.find(b => pct >= b.min) || BANDS[BANDS.length - 1]; }
const STREAK_THRESHOLD = 95;   // a streak week is a win week

// ===================== ICONS =====================
const ICONS = {
  grid:    '<rect x="3" y="3" width="7" height="7" rx="1.5"/><rect x="14" y="3" width="7" height="7" rx="1.5"/><rect x="3" y="14" width="7" height="7" rx="1.5"/><rect x="14" y="14" width="7" height="7" rx="1.5"/>',
  list:    '<path d="M9 6h12M9 12h12M9 18h12"/><path d="M4 6h.01M4 12h.01M4 18h.01"/>',
  shield:  '<path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/>',
  award:   '<circle cx="12" cy="9" r="6"/><path d="M8.5 14L7 21l5-3 5 3-1.5-7"/>',
  news:    '<path d="M3 11v2a1 1 0 0 0 1 1h3l6 4V6L7 10H4a1 1 0 0 0-1 1z"/><path d="M17 9a4 4 0 0 1 0 6"/>',
  tv:      '<rect x="3" y="5" width="18" height="12" rx="2"/><path d="M8 21h8M12 17v4"/>',
  trophy:  '<path d="M8 4h8v5a4 4 0 0 1-8 0z"/><path d="M8 6H5v1a3 3 0 0 0 3 3M16 6h3v1a3 3 0 0 1-3 3M12 13v4M8 21h8M9 17h6"/>',
  star:    '<path d="M12 3l2.6 5.6 6.1.7-4.5 4.2 1.2 6L12 16.8 6.6 19.5l1.2-6-4.5-4.2 6.1-.7z"/>',
  sliders: '<path d="M4 6h9M17 6h3M4 12h3M11 12h9M4 18h11M19 18h1"/><circle cx="15" cy="6" r="2"/><circle cx="9" cy="12" r="2"/><circle cx="17" cy="18" r="2"/>',
  print:   '<path d="M6 9V3h12v6"/><rect x="3" y="9" width="18" height="8" rx="2"/><path d="M6 14h12v7H6z"/>',
  refresh: '<path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/>',
  link:    '<path d="M10 14a4 4 0 0 0 5.7 0l3-3a4 4 0 0 0-5.7-5.7l-1 1"/><path d="M14 10a4 4 0 0 0-5.7 0l-3 3a4 4 0 0 0 5.7 5.7l1-1"/>',
  idcard:  '<rect x="3" y="5" width="18" height="14" rx="2"/><circle cx="9" cy="11" r="2"/><path d="M6 16c.8-1.4 1.9-2 3-2s2.2.6 3 2M15 10h3M15 13h3"/>',
};
function ico(name) {
  return `<svg class="ico" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${ICONS[name] || ''}</svg>`;
}
function paintIcons(root) {
  (root || document).querySelectorAll('[data-ico]').forEach(el => {
    if (el.dataset.painted) return;
    el.insertAdjacentHTML('afterbegin', ico(el.dataset.ico));
    el.dataset.painted = '1';
  });
}

// ===================== STATE =====================
let settings = { sheetUrl: '', pin: DEFAULT_PIN, title: 'Attendance League' };
let classes = [];          // [{ id, name, house, colour, emoji, attendance: {1:96.2,...} }]
let weekCount = 0;
let usingHouses = false;
let isAuthenticated = false;
let pinCallback = null;
let lastLoadedAt = null;
let currentView = 'overview';
let statsCache = new Map();

const VIEW_TITLES = { overview: 'Overview', table: 'League table', houses: 'Houses', badges: 'Badges', news: 'League news' };
// Plain colour names typed in the sheet are swapped for softer shades that sit well on white
const NAMED_COLOURS = { red: '#e05a6a', green: '#3aa76d', yellow: '#e5b931', blue: '#3d7dd8', purple: '#8b6fd6',
  orange: '#e88a3a', pink: '#d665a8', teal: '#2fb3a6', black: '#374151', grey: '#9aa3b2', gray: '#9aa3b2' };
const DEFAULT_HOUSE_COLOURS = ['#e05a6a', '#3aa76d', '#e0b33a', '#3d8bd9', '#8b6fd6', '#e08a3a', '#d665a8', '#2fb3a6'];

// ===================== BADGES =====================
// Recognition only — badges never add points. Checks receive `es`, the group's
// weeks with data in order as [{ w, v }], so they work at any point in the season.
const BADGES = [
  { id:'on_target',     emoji:'🎯', name:'On Target',     desc:'A week at 97%+',
    check: es => es.some(e => e.v >= 97) },
  { id:'personal_best', emoji:'⚡', name:'Personal Best', desc:'Beat your own best week',
    check: es => es.some((e, i) => i > 0 && e.v > Math.max(...es.slice(0, i).map(x => x.v))) },
  { id:'comeback',      emoji:'🛡', name:'Comeback',      desc:'Back to 95%+ after a week below 90%',
    check: es => es.some((e, i) => i > 0 && es[i-1].v < 90 && e.v >= 95) },
  { id:'treble',        emoji:'🔥', name:'Treble',        desc:'Three weeks at 95%+',
    check: es => es.filter(e => e.v >= 95).length >= 3 },
  { id:'unbeaten',      emoji:'🌟', name:'Unbeaten',      desc:'Three weeks in, never below 90%',
    check: es => es.length >= 3 && es.every(e => e.v >= 90) },
  { id:'perfect_week',  emoji:'💯', name:'Perfect Week',  desc:'100% in a single week',
    check: es => es.some(e => e.v === 100) },
  { id:'hat_trick',     emoji:'⭐', name:'Hat-trick',     desc:'Three weeks at 97%+',
    check: es => es.filter(e => e.v >= 97).length >= 3 },
  { id:'diamond',       emoji:'💎', name:'Diamond',       desc:'97%+ in every week played (min 3)',
    check: es => es.length >= 3 && es.every(e => e.v >= 97) },
];

// Weeks with data, in order, up to and including maxW
function entriesUpTo(cls, maxW) {
  const out = [], limit = maxW || weekCount;
  for (let w = 1; w <= limit; w++) if (cls.attendance[w] !== undefined) out.push({ w, v: cls.attendance[w] });
  return out;
}
function getEarnedBadges(cls, maxW) { const es = entriesUpTo(cls, maxW); return BADGES.filter(b => b.check(es)); }
function getNextBadge(cls) {
  const earned = new Set(getEarnedBadges(cls).map(b => b.id));
  // Comeback only makes sense to aim for after a week below 90%
  const hadDip = entriesUpTo(cls).some(e => e.v < 90);
  return BADGES.find(b => !earned.has(b.id) && (b.id !== 'comeback' || hadDip)) || null;   // ordered easiest first
}

// ===================== PERSISTENCE =====================
function loadSettings() {
  try { const raw = localStorage.getItem(STORAGE_KEY); if (raw) settings = Object.assign(settings, JSON.parse(raw)); } catch (e) {}
}
function saveSettings() {
  try { localStorage.setItem(STORAGE_KEY, JSON.stringify(settings)); } catch (e) {}
}

// ===================== CSV FETCH & PARSE =====================
function parseCSV(text) {
  const rows = [];
  let row = [], field = '', inQuotes = false;
  for (let i = 0; i < text.length; i++) {
    const ch = text[i], next = text[i + 1];
    if (inQuotes) {
      if (ch === '"' && next === '"') { field += '"'; i++; }
      else if (ch === '"') inQuotes = false;
      else field += ch;
    } else {
      if (ch === '"') inQuotes = true;
      else if (ch === ',') { row.push(field); field = ''; }
      else if (ch === '\r') { /* skip */ }
      else if (ch === '\n') { row.push(field); rows.push(row); row = []; field = ''; }
      else field += ch;
    }
  }
  if (field.length > 0 || row.length > 0) { row.push(field); rows.push(row); }
  return rows.filter(r => r.some(c => c.trim() !== ''));
}

function normaliseSheetUrl(url) {
  url = url.trim();
  if (url.includes('output=csv') || url.includes('/pub?')) return url;
  const m = url.match(/\/spreadsheets\/d\/([a-zA-Z0-9-_]+)/);
  if (m) {
    let gid = '0';
    const g = url.match(/[#&?]gid=([0-9]+)/);
    if (g) gid = g[1];
    return `https://docs.google.com/spreadsheets/d/${m[1]}/export?format=csv&gid=${gid}`;
  }
  return url;
}

async function fetchSheet(url) {
  const resp = await fetch(normaliseSheetUrl(url), { cache: 'no-store' });
  if (!resp.ok) throw new Error('HTTP ' + resp.status);
  return await resp.text();
}

function ingestRows(rows) {
  if (!rows.length) throw new Error('The sheet appears to be empty.');
  const header = rows[0].map(h => h.trim().toLowerCase());
  const groupIdx  = header.findIndex(h => h === 'group' || h === 'reg group' || h === 'name' || h === 'registration group');
  const houseIdx  = header.findIndex(h => h === 'house');
  const colourIdx = header.findIndex(h => h === 'colour' || h === 'color' || h === 'house colour' || h === 'house color');
  const emojiIdx  = header.findIndex(h => h === 'emoji' || h === 'icon' || h === 'badge');
  const weekCols = [];
  header.forEach((h, i) => { if (/^(week|wk|w)\s*\d+$/.test(h) || /week/.test(h)) weekCols.push(i); });

  if (groupIdx === -1) throw new Error('No "Group" column found in the sheet.');
  if (!weekCols.length) throw new Error('No week columns found. Add columns named "Week 1", "Week 2", etc.');

  const out = [];
  let houseSeen = false, colourCursor = 0;
  const houseColourMap = {};
  for (let r = 1; r < rows.length; r++) {
    const cells = rows[r];
    const name = (cells[groupIdx] || '').trim();
    if (!name) continue;
    const house = houseIdx > -1 ? (cells[houseIdx] || '').trim() : '';
    if (house) houseSeen = true;
    let colour = colourIdx > -1 ? (cells[colourIdx] || '').trim() : '';
    if (NAMED_COLOURS[colour.toLowerCase()]) colour = NAMED_COLOURS[colour.toLowerCase()];
    if (!colour) {
      const key = house || name;
      if (!houseColourMap[key]) houseColourMap[key] = DEFAULT_HOUSE_COLOURS[colourCursor++ % DEFAULT_HOUSE_COLOURS.length];
      colour = houseColourMap[key];
    }
    const attendance = {};
    weekCols.forEach((ci, wi) => {
      const raw = (cells[ci] || '').trim().replace('%', '');
      if (raw !== '' && !isNaN(parseFloat(raw))) attendance[wi + 1] = parseFloat(raw);
    });
    const emoji = emojiIdx > -1 ? (cells[emojiIdx] || '').trim() : '';
    out.push({ id: r, name, house, colour, emoji, attendance });
  }
  classes = out;
  weekCount = weekCols.length;
  usingHouses = houseSeen;
  lastLoadedAt = new Date();
  statsCache = new Map();
}

async function loadFromSheet(url, opts) {
  opts = opts || {};
  const text = await fetchSheet(url);
  ingestRows(parseCSV(text));
  if (opts.silent !== true) toast('Data loaded from sheet');
}

// ===================== STATS =====================
// The single source of truth for scoring.
function getStats(cls, maxW) {
  const key = cls.id + ':' + (maxW || 0);
  if (statsCache.has(key)) return statsCache.get(key);
  const es = entriesUpTo(cls, maxW);
  let run = 0, pts = 0, total = 0, best = null;
  const counts = { win: 0, draw: 0, point: 0, none: 0 };
  const rows = es.map(e => {
    const band = bandFor(e.v);
    run = e.v >= STREAK_THRESHOLD ? run + 1 : 0;
    pts += band.pts; total += e.v; counts[band.key]++;
    if (best === null || e.v > best) best = e.v;
    return { week: e.w, pct: e.v, band, pts: band.pts };
  });
  const played = rows.length;
  const s = {
    played, rows, pts,
    wins: counts.win, draws: counts.draw, ones: counts.point, zeros: counts.none,
    badges: BADGES.filter(b => b.check(es)),
    overallPct: played ? total / played : null,
    bestPct: best,
    streak: run,
    lastWeekPts: played ? rows[played - 1].pts : null,
  };
  statsCache.set(key, s);
  return s;
}

function rankCompare(a, b, sa, sb) {
  if (sb.pts !== sa.pts) return sb.pts - sa.pts;
  if ((sb.overallPct || 0) !== (sa.overallPct || 0)) return (sb.overallPct || 0) - (sa.overallPct || 0);
  return a.name.localeCompare(b.name, 'en', { numeric: true });
}
function getSortedClasses() {
  return [...classes].sort((a, b) => rankCompare(a, b, getStats(a), getStats(b)));
}

function latestWeekWithData() {
  let latest = 0;
  classes.forEach(c => { for (let w = 1; w <= weekCount; w++) if (c.attendance[w] !== undefined && w > latest) latest = w; });
  return latest;
}

// Positions as at the end of a given week
function rankingsAtWeek(w) {
  const ranked = classes.filter(c => entriesUpTo(c, w).length)
    .sort((a, b) => rankCompare(a, b, getStats(a, w), getStats(b, w)));
  const pos = {}; ranked.forEach((c, i) => pos[c.id] = i + 1); return pos;
}
function getMovements() {
  const latest = latestWeekWithData();
  return latest <= 1 ? {} : rankingsAtWeek(latest - 1);
}

function getMostImproved() {
  const latest = latestWeekWithData();
  if (latest <= 1) return null;
  let best = null, bestDiff = 0;
  classes.forEach(c => {
    const curr = c.attendance[latest], prev = c.attendance[latest - 1];
    if (curr !== undefined && prev !== undefined && curr - prev > bestDiff) { bestDiff = curr - prev; best = c; }
  });
  return best ? { cls: best, diff: bestDiff } : null;
}
function getBiggestClimber() {
  const latest = latestWeekWithData();
  if (latest <= 1) return null;
  const curr = rankingsAtWeek(latest), prev = rankingsAtWeek(latest - 1);
  let best = null, bestGain = 0;
  classes.forEach(c => {
    if (c.attendance[latest] === undefined || prev[c.id] === undefined || curr[c.id] === undefined) return;
    const gain = prev[c.id] - curr[c.id];
    if (gain > bestGain) { bestGain = gain; best = c; }
  });
  return best ? { cls: best, places: bestGain } : null;
}
function getMostImprovedAllTime() {
  const latest = latestWeekWithData();
  if (latest <= 1) return null;
  let best = null, bestDiff = 0, fromW = 0, toW = 0;
  classes.forEach(cls => {
    for (let w = 2; w <= latest; w++) {
      const curr = cls.attendance[w], prev = cls.attendance[w - 1];
      if (curr !== undefined && prev !== undefined && curr - prev > bestDiff) { bestDiff = curr - prev; best = cls; fromW = w - 1; toW = w; }
    }
  });
  return best ? { cls: best, diff: bestDiff, fromWeek: fromW, toWeek: toW } : null;
}
function getBiggestClimberAllTime() {
  const latest = latestWeekWithData();
  if (latest <= 1) return null;
  let best = null, bestGain = 0, fromW = 0, toW = 0;
  for (let w = 2; w <= latest; w++) {
    const prev = rankingsAtWeek(w - 1), curr = rankingsAtWeek(w);
    classes.forEach(cls => {
      if (prev[cls.id] === undefined || curr[cls.id] === undefined) return;
      const gain = prev[cls.id] - curr[cls.id];
      if (gain > bestGain) { bestGain = gain; best = cls; fromW = w - 1; toW = w; }
    });
  }
  return best ? { cls: best, places: bestGain, fromWeek: fromW, toWeek: toW } : null;
}

function getHouseStats() {
  if (!usingHouses) return [];
  const map = {};
  classes.forEach(c => {
    if (!c.house) return;
    if (!map[c.house]) map[c.house] = { name: c.house, colour: c.colour, pts: 0, wins: 0, pcts: [], groups: 0 };
    const s = getStats(c), h = map[c.house];
    h.pts += s.pts; h.wins += s.wins; h.groups++;
    if (s.overallPct !== null) h.pcts.push(s.overallPct);
  });
  return Object.values(map).map(h => ({
    name: h.name, colour: h.colour, pts: h.pts, wins: h.wins, groups: h.groups,
    avg: h.pcts.length ? h.pcts.reduce((a, b) => a + b, 0) / h.pcts.length : null,
  })).sort((a, b) => b.pts !== a.pts ? b.pts - a.pts : (b.avg || 0) - (a.avg || 0));
}

// Things a group is defending right now — positive, never shaming
function getTitleRace() {
  const sorted = getSortedClasses().filter(c => getStats(c).played > 0);
  if (sorted.length < 2) return null;
  return { leader: sorted[0], chaser: sorted[1], gap: getStats(sorted[0]).pts - getStats(sorted[1]).pts };
}
function isUnbeaten(cls) { const es = entriesUpTo(cls); return es.length >= 3 && es.every(e => e.v >= 90); }
let raceCache = null;
function statusChip(cls) {
  if (raceCache && raceCache.gap <= 3) {
    if (cls.id === raceCache.leader.id) return `<span class="chip gold" title="Only ${raceCache.gap} point${raceCache.gap === 1 ? '' : 's'} clear at the top">👑 Defending top spot</span>`;
    if (cls.id === raceCache.chaser.id) return `<span class="chip accent" title="Within reach of 1st place">${raceCache.gap === 0 ? 'Level on points with 1st' : raceCache.gap + ' pt' + (raceCache.gap === 1 ? '' : 's') + ' off top'}</span>`;
  }
  if (isUnbeaten(cls)) return `<span class="chip gold" title="Never below 90%">🛡 Unbeaten</span>`;
  return '';
}

// ===================== FORMAT HELPERS =====================
const esc = s => String(s).replace(/[&<>"']/g, ch => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]));
const pct = v => v === null || v === undefined ? '—' : v.toFixed(1) + '%';
const plural = (n, w) => `${n} ${w}${n === 1 ? '' : 's'}`;
const nm = c => `${c.emoji ? c.emoji + ' ' : ''}${esc(c.name)}`;
function ordSuffix(n) { const s = ['th', 'st', 'nd', 'rd'], v = n % 100; return s[(v - 20) % 10] || s[v] || s[0]; }
function rankBadge(pos, played) { return `<span class="rank${played && pos <= 3 ? ' r' + pos : ''}">${pos}</span>`; }
function moveTag(prev, pos) {
  if (prev === undefined) return '';
  const d = prev - pos;
  if (d > 0) return `<span class="move up" title="Up ${d} since last week">▲${d}</span>`;
  if (d < 0) return `<span class="move down" title="Down ${-d} since last week">▼${-d}</span>`;
  return `<span class="move flat" title="Same place as last week">–</span>`;
}
function formDots(s) {
  return s.rows.length
    ? `<span class="form-dots" title="One dot per week">${s.rows.map(r => `<span class="fd ${r.band.key}" title="Week ${r.week}: ${r.pct.toFixed(1)}% · ${r.band.label} · ${r.pts} pt${r.pts === 1 ? '' : 's'}"></span>`).join('')}</span>`
    : '';
}
function streakChip(s) { return s.streak >= 2 ? `<span class="chip" title="${s.streak} weeks in a row at 95%+">🔥 ${s.streak}-week streak</span>` : ''; }
function badgeChip(s) { return s.badges.length ? `<span class="chip" title="${esc(s.badges.map(b => b.emoji + ' ' + b.name).join(' · '))}">🏅 ${s.badges.length}</span>` : ''; }
function houseQuote(name) { return esc(name).replace(/\\/g, '\\\\').replace(/&#39;/g, "\\'"); }

// ===================== NAVIGATION =====================
function showView(view) {
  currentView = view;
  document.querySelectorAll('.nav-item[data-view]').forEach(b => b.classList.toggle('active', b.dataset.view === view));
  document.querySelectorAll('.view').forEach(v => v.hidden = v.id !== 'view-' + view);
  document.getElementById('viewTitle').textContent = VIEW_TITLES[view] || 'Overview';
  window.scrollTo({ top: 0 });
}

// ===================== RENDER =====================
function render() {
  statsCache = new Map();
  renderStatusLine();
  document.getElementById('brandTitle').textContent = settings.title || 'Attendance League';

  if (!classes.length) {
    document.getElementById('dashboard').hidden = true;
    renderSetup();
    return;
  }
  document.getElementById('setupState').innerHTML = '';
  document.getElementById('dashboard').hidden = false;

  const sorted = getSortedClasses();
  const prev = getMovements();
  raceCache = getTitleRace();

  renderOverview(sorted, prev);
  renderTable(sorted, prev);
  renderHouses();
  renderBadges();
  renderNews();
  renderEntryTracker();
  paintIcons();
}

function renderStatusLine() {
  const sl = document.getElementById('statusLine');
  if (!classes.length) { sl.innerHTML = ''; return; }
  const lw = latestWeekWithData();
  const pills = [];
  pills.push(`<span class="pill">${plural(classes.length, 'group')}</span>`);
  if (lw) pills.push(`<span class="pill">Latest: Week ${lw} of ${weekCount}</span>`);
  if (lastLoadedAt) pills.push(`<span class="pill">Updated ${lastLoadedAt.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' })}</span>`);
  sl.innerHTML = pills.join('');
}

function weekAverage(w) {
  const vals = classes.map(c => c.attendance[w]).filter(v => v !== undefined);
  return vals.length ? vals.reduce((a, b) => a + b, 0) / vals.length : null;
}

