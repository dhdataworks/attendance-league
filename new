async function refreshData() {
  const url = effectiveSheetUrl();
  if (!url) { openDataSource(); return; }
  try { await loadFromSheet(url); render(); }
  catch (e) { toast('Refresh failed. Check the sheet is still published.'); render(); }
}
function downloadTemplate() {
  const csv = 'Group,House,Colour,Emoji,Week 1,Week 2,Week 3,Week 4,Week 5,Week 6\n' +
    '7A,Dragon,Red,🐉,,,,,,\n7B,Griffin,Green,🦅,,,,,,\n8A,Dragon,Red,⚡,,,,,,\n8B,Griffin,Green,⭐,,,,,,\n';
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(['﻿' + csv], { type: 'text/csv;charset=utf-8' }));
  a.download = 'attendance-league-template.csv';
