// ===================== GROUP CARD =====================
// Weekly bars, coloured by result. `large` adds percentage labels.
function sparkSVG(cls, large) {
  const W = large ? 560 : 280, H = large ? 92 : 46, gap = large ? 8 : 5, top = large ? 18 : 4;
  const n = Math.max(weekCount, 1);
  const barW = Math.min(large ? 64 : 30, Math.max(8, (W - gap * (n - 1)) / n));
  const x0 = (W - (barW * n + gap * (n - 1))) / 2;
  const colour = { win: '#2f9e5b', draw: '#e2a12b', point: '#3d78d6', none: '#d4566e' };
  let out = '';
  for (let w = 1; w <= weekCount; w++) {
    const v = cls.attendance[w];
    const x = x0 + (w - 1) * (barW + gap);
    const h = v !== undefined ? Math.max(3, (Math.max(0, v - 50) / 50) * (H - top)) : 3;
    const col = v !== undefined ? colour[bandFor(v).key] : '#e6e9f0';
    out += `<rect x="${x.toFixed(1)}" y="${(H - h).toFixed(1)}" width="${barW.toFixed(1)}" height="${h.toFixed(1)}" rx="3" fill="${col}"/>`;
    if (large && v !== undefined) out += `<text x="${(x + barW / 2).toFixed(1)}" y="${(H - h - 5).toFixed(1)}" text-anchor="middle" font-family="Inter,sans-serif" font-size="10" font-weight="600" fill="#4b5563">${v.toFixed(1)}</text>`;
    out += `<text x="${(x + barW / 2).toFixed(1)}" y="${H + (large ? 14 : 11)}" text-anchor="middle" font-family="Inter,sans-serif" font-size="${large ? 10 : 8}" fill="#8a93a6">W${w}</text>`;
  }
  return `<svg viewBox="0 0 ${W} ${H + (large ? 18 : 14)}" style="width:100%;display:block" role="img" aria-label="Weekly attendance for ${esc(cls.name)}">${out}</svg>`;
}

// The single next target for this group, in points
function groupMission(s) {
  const last = s.rows.length ? s.rows[s.rows.length - 1] : null;
  if (!last) return 'First week on the board: <b>95%+</b> is a win worth 3 points.';
  if (last.pct >= 95) return s.streak >= 2
    ? `Another week at <b>95%+</b> makes it ${s.streak + 1} wins in a row (3 more points).`
    : 'Hold <b>95%+</b> for another win and 3 more points.';
  const next = [...BANDS].reverse().find(b => b.min > last.pct);
  return `Last week was ${last.pct.toFixed(1)}% (${last.band.label.toLowerCase()}). Reach <b>${next.min}%</b> for a ${next.label.toLowerCase()} worth ${plural(next.pts, 'point')}.`;
}

