async function saveDataSource() {
  const url = document.getElementById('sheetUrlInput').value.trim();
  if (!url) { toast('Please paste a link first'); return; }
  try {
    await loadFromSheet(url, { silent: true });
    settings.sheetUrl = url; saveSettings();
    closeDataSource(); render(); toast('Connected, data loaded');
  } catch (e) { toast('Could not read that sheet. Check it is published to the web as CSV.'); }
